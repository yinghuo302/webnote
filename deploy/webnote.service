[Unit]
Description=Webnote Go API
Wants=postgresql.service
After=network.target postgresql.service

[Service]
Type=simple
User=web
Group=web
WorkingDirectory=/opt/webnote
LoadCredential=webnote.env:/opt/webnote/config/webnote.env
Environment=WEBNOTE_ADDRESS=127.0.0.1
Environment=WEBNOTE_PORT=8000
Environment=WEBNOTE_DATA_DIR=/opt/webnote/data/legacy
Environment=WEBNOTE_IMG_DIR=/opt/webnote/data/img
Environment=WEBNOTE_SECURE_COOKIES=true
ExecStart=/opt/webnote/bin/webnote
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/webnote/data
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
